# Relay Studio (Option A) — Environment Variable Template
# Copy to .env.local for local development, or run `vercel env pull` on a linked Vercel project.

# Set automatically by Vercel on deployments (or via `vercel env pull` locally).
# Authenticates requests to Vercel AI Gateway and Vercel Sandbox.
VERCEL_OIDC_TOKEN=""

# Optional local development credential for Vercel AI Gateway when VERCEL_OIDC_TOKEN is unset.
# If neither VERCEL_OIDC_TOKEN nor AI_GATEWAY_API_KEY is set, POST /api/agent/chat returns
# the setup error part defined in 01_Option_A_Relay_Studio_Vercel_App_Spec.md Section 10.
AI_GATEWAY_API_KEY=""

# Ordered comma-separated free-tier model lists (index 0 = primary, remaining = ordered fallbacks).
FAST_MODELS="nvidia/nemotron-3.5-lightning-free,reflection/beam-free,stealth/glyph-cluster"
REASONING_MODELS="reflection/beam-free,humansand/ampersand-v0.1,recursive/flint-v1.0"

# Semantic model router for free-form prompts ("decisions" | "free-llm" | "keyword").
# "decisions" calls Vercel AI Gateway POST /v1/decisions (baseten/joey-1) and falls back
# automatically to $0 free-tier LLM classification (on 402/403) and then keyword regex.
SEMANTIC_ROUTER_MODE="decisions"
DECISION_ROUTER_MODEL="baseten/joey-1"

# Optional custom reporting tags flag ("1" attaches ["app:relay-studio-demo"]; default "0" off).
GATEWAY_REPORTING_TAGS="0"

# Optional Sandbox override ("1" forces the in-process Python sqlite3 fallback; default "0" off).
SANDBOX_DISABLED="0"

# Optional Neon Serverless Postgres connection string (injected automatically by Vercel Marketplace).
# When unset locally, Relay Studio runs cleanly in browser-local mode.
DATABASE_URL=""

# Optional opt-in ("1") that lets a deployment replace the Neon relay_daily_performance rows
# when its bundled backend/data/rows.csv differs from what the database holds. Leave "0" on
# Preview when Preview and Production share one database.
RELAY_RESEED_DATASET="0"
